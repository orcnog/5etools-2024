	"bookData": [
		{
			"id": "sw5e-syotg",
			"source": "sw5e-syotg",
			"data": [
				{
					"type": "section",
					"name": "Introduction",
					"page": 1,
					"entries": [
						"A compendium of various links to pages, tools, and information for use with SW5e's Starships of the Galaxy.",
						"You DO NOT need to get editing access for Gsheets, you can duplicate them for your own use, under the File option in the top left.",
						{
							"type": "entries",
							"name": "Shipbuilder and Shipyard",
							"entries": [
								{
									"type": "list",
									"items": [
										"{@link SotG Shipbuilder and Shipyard|https://docs.google.com/spreadsheets/d/18FtTlLeyi3OYTbVFZ1P9r4qBS16XV89N2i3umztiv3I/edit} {@note Google Sheets link}"
									]
								},
								"Blank version of the Automated sheets used in the Shipyards to help create starships.",
								"(Duplicate the entire sheet for your own use)"
							]
						},
						{
							"type": "entries",
							"name": "Post-July 2022 Shipyards",
							"entries": [
								"{@b Most official}",
								{
									"type": "list",
									"items": [
										"{@link New SotG Shipyard - Original Trilogy + EU|https://docs.google.com/spreadsheets/d/1zS3_gSCXIatGYY5_8IHvkOK4WcYCo6t3ZTx3fQFUIms/edit} {@note Google Sheets link}",
										"{@link Misc - Post-July 2023 - SotG Shipyard|https://docs.google.com/spreadsheets/d/19pXrp54f-IXj4S7A3_iTX3AtOaWRqAXTnqsSOAVCHcY/edit} {@note Google Sheets link}"
									]
								},
								"{@b Community - Endorsed}",
								{
									"type": "list",
									"items": [
										"{@link Tuskman's shipyard|https://docs.google.com/spreadsheets/d/1ttAcOn8WXclOZSbJmo7Kci6B5Nk21k7AZPiWW9JsO4o/edit} {@note Google Sheets link} {@homebrew URL corrected|On {@link Shipyards of the Galaxy|https://www.gmbinder.com/share/-M7y5JXBmMCskhJPFhUp} {@note GM Binder link}, the published hyperlink pointed to {@link SotG Shipbuilder and Shipyard|https://docs.google.com/spreadsheets/d/18FtTlLeyi3OYTbVFZ1P9r4qBS16XV89N2i3umztiv3I/edit} {@note Google Sheets link} instead. Imported statblocks are under {@book Tuskman's Shipyard|sw5e-syotg|2|Tuskman's Shipyard}.}"
									]
								},
								"{@b Community}",
								{
									"type": "list",
									"items": [
										"{@b CharlestheDwarf's ships} {@homebrew Link unavailable|On {@link Shipyards of the Galaxy|https://www.gmbinder.com/share/-M7y5JXBmMCskhJPFhUp} {@note GM Binder link}, the published hyperlink pointed to {@link Tuskman's random collection of starships|https://docs.google.com/spreadsheets/d/1ttAcOn8WXclOZSbJmo7Kci6B5Nk21k7AZPiWW9JsO4o/edit} {@note Google Sheets link} instead. No separate CharlestheDwarf shipyard appears on that page; the mislinked URL is Tuskman's collection (see {@book Tuskman's Shipyard|sw5e-syotg|2|Tuskman's Shipyard}).}",
										"{@link El Mike's Old Republic ships|https://docs.google.com/spreadsheets/d/12R8Db-ai8LGWFWUkG5FMVASVMaJEeKOwK8q2UJEsw9Y/edit} {@note Google Sheets link}"
									]
								},
								"{@b Older ships using new rules}",
								{
									"type": "list",
									"items": [
										"{@link Corso's straight conversion of Starships from SotG 3/16/2021 to SotG 7/5/2022|https://docs.google.com/spreadsheets/d/1LgbpstjyCWPQr-4crJ9VXDe1Gmglzpvaq6sXVSQ2fOo/edit} {@note Google Sheets link}"
									]
								}
							]
						},
						{
							"type": "entries",
							"name": "Pre-July 2022 update",
							"entries": [
								"All links below are older than the July 2022 update, use with caution",
								{
									"type": "entries",
									"name": "Google Sheets shipyards",
									"entries": [
										"Links to Google Sheets documents with pre-built starships stated out for GM and player use.",
										{
											"type": "entries",
											"name": "Using with the July 2022 update",
											"entries": [
												"While the starships below are built using older SotG rules, they can still be played perfectly fine with the current. The main difference will be in how their speeds are calculated, although some modifications have been altered.",
												{
													"type": "list",
													"items": [
														"{@link Pre-July Gsheet (link)|https://docs.google.com/spreadsheets/d/1ozkVBgDR1LH6HyjY_WweBuN3VxZ3UgSvABkuWYr5rkg/edit} {@note Google Sheets link}"
													]
												},
												"The main shipyard currated by Drake Ryzer and Aziz. Has most of the small and medium starships we see in the movies and TV shows, among others",
												{
													"type": "list",
													"items": [
														"{@link Darksamus's Capital Shipyard (link)|https://docs.google.com/spreadsheets/d/1TBZAej3hPhn2QMykc82wehjjuIKMLe_XB4-fy7eyTGo/edit} {@note Google Sheets link}"
													]
												},
												"Various large to gargantuan Starships"
											]
										}
									]
								},
								{
									"type": "entries",
									"name": "Helpful tools",
									"entries": [
										"Various tools and information for making starships",
										{
											"type": "list",
											"items": [
												"{@book Starship Hangar Capacities|sw5e-syotg|2|Starship Hangar Capacities} {@note included in this book}"
											]
										},
										"For use in referencing how much space a starship has for other ships and constructs.",
										{
											"type": "list",
											"items": [
												"{@link Darksamus's Pre-July 2022 update Quick Combat Reference|https://www.gmbinder.com/share/-M_VUBhczOy3Kt5MvYYX} {@note GM Binder link}"
											]
										},
										"Although many specifics on how ships function has changed, this series is still a good starting point for how to run Starships of the Galaxy."
									]
								}
							]
						}
					]
				},
