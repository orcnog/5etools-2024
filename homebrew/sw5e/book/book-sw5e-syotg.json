			"data": [
				{
					"type": "section",
					"name": "Introduction",
					"page": 1,
					"entries": [
						"Shipyards of the Galaxy is a compendium of links, tools, and quick-reference material for use with SW5e's Starships of the Galaxy.",
						{
							"type": "entries",
							"name": "Shipbuilder and Shipyard",
							"entries": [
								"SotG Shipbuilder and Shipyard: a blank automated sheet to create starships. Duplicate the sheet for your own use.",
								"Reference page: [Shipyards of the Galaxy](https://www.gmbinder.com/share/-M7y5JXBmMCskhJPFhUp)."
							]
						},
						{
							"type": "entries",
							"name": "Post-July 2022 Shipyards",
							"entries": [
								"Most official:",
								{
									"type": "list",
									"items": [
										"New SotG Shipyard - Original Trilogy + EU",
										"Misc - Post-July 2023 - SotG Shipyard"
									]
								},
								"Community-endorsed and community shipyards are also available from the same reference page."
							]
						},
						{
							"type": "entries",
							"name": "Helpful Tools",
							"entries": [
								"Starship Hangar Capacities (included in this book).",
								"Reference page: [Starship Hangar capacities](https://www.gmbinder.com/share/-LqgEdrDbah1rdmXYp78)."
							]
						}
					]
				},
